// Merged from provided scripts; all sections preserved.
indicator('FVG + Divergence + Key Levels (Merged)', shorttitle='FVG+Div+KeyLvls', overlay=true, max_bars_back=1000, max_lines_count=500, max_labels_count=500)

// === Settings ===
boxLength = input.int(20, 'Box Length (Native / 15m / 1H)', minval=1)
boxLength4H = input.int(30, 'Box Length (4H)', minval=1)
boxLengthD = input.int(40, 'Box Length (Daily)', minval=1)
boxLengthW = input.int(50, 'Box Length (Weekly)', minval=1)
boxLengthM = input.int(60, 'Box Length (Monthly)', minval=1)
maxTrackBars = input.int(5000, 'Max Track Bars', minval=1)
checkForwardBars = input.int(5000, 'Check Forward Bars', minval=1)
removeOnMitigation = input.bool(false, 'Remove FVG After First Mitigation')

// === Arrays ===
var box[] fvgBoxes = array.new_box()
var label[] fvgLabels = array.new_label()
var int[] fvgCreatedBars = array.new_int()
var bool[] fvgIsBullish = array.new_bool()
var float[] fvgCompareLevels = array.new_float()
var bool[] fvgAlerted = array.new_bool()

// === Timeframe Rank Logic ===
timeframeRank(tf) =>
    if timeframe.isseconds
        0
    else
        switch tf
            '1' => 1
            '2' => 2
            '3' => 3
            '5' => 4
            '15' => 10
            '30' => 11
            '60' => 20
            '120' => 21
            '240' => 30
            'D' => 40
            'W' => 50
            'M' => 60
            => 0

chartTFRank = timeframeRank(timeframe.period)
rank15M = timeframeRank('15')
rank1H = timeframeRank('60')
rank4H = timeframeRank('240')
rankD = timeframeRank('D')
rankW = timeframeRank('W')
rankM = timeframeRank('M')

// === Smart Label Function ===
getSmartLabel() =>
    if timeframe.isseconds
        timeframe.period
    else if timeframe.isintraday
        minVal = str.tonumber(timeframe.period)
        if not na(minVal) and minVal >= 60 and minVal % 60 == 0
            str.tostring(minVal / 60) + 'H'
        else
            timeframe.period + 'm'
    else
        timeframe.period

nativeLabel = getSmartLabel()

// === Helper Function to Draw FVGs ===
drawFVG(timeStart, top, bottom, labelText, color_, compare, isBullish, lenBars) =>
    realTop = math.max(top, bottom)
    realBot = math.min(top, bottom)
    mid = (realTop + realBot) / 2

    // Calculate box width in time
    tfInMs = timeframe.in_seconds(timeframe.period) * 1000
    widthMult = tfInMs == 0 ? 60000 : tfInMs
    timeEnd = timeStart + lenBars * widthMult

    boxColor = labelText == '4H' ? color.new(color_, 60) : color.new(color_, 85)
    border = labelText == '4H' ? color.gray : na

    b = box.new(left=timeStart, right=timeEnd, top=realTop, bottom=realBot, border_color=border, bgcolor=boxColor, xloc=xloc.bar_time)

    array.push(fvgBoxes, b)
    array.push(fvgCreatedBars, bar_index)
    array.push(fvgIsBullish, isBullish)
    array.push(fvgCompareLevels, compare)

    // Calculate Label Position
    lbY = isBullish ? mid : mid - (realTop - realBot) * 0.3

    newLabel = label.new(x=timeEnd, y=lbY, text=labelText, style=label.style_none, size=size.normal, textcolor=isBullish ? color.green : color.red, xloc=xloc.bar_time)
    array.push(fvgLabels, newLabel)

    // Initialize alert status
    array.push(fvgAlerted, false)

// === Data Requests ===
[fb15m, ff15m, ft15m, fh3_15, fl3_15, fh1_15, fl1_15] = request.security(syminfo.tickerid, '15', [low[1] > high[3] ? 1 : 0, high[1] < low[3] ? 1 : 0, time[3], high[3], low[3], high[1], low[1]])
[fb1H, ff1H, ft1H, fh3_1H, fl3_1H, fh1_1H, fl1_1H] = request.security(syminfo.tickerid, '60', [low[1] > high[3] ? 1 : 0, high[1] < low[3] ? 1 : 0, time[3], high[3], low[3], high[1], low[1]])
[fb4H, ff4H, ft4H, fh3_4H, fl3_4H, fh1_4H, fl1_4H] = request.security(syminfo.tickerid, '240', [low[1] > high[3] ? 1 : 0, high[1] < low[3] ? 1 : 0, time[3], high[3], low[3], high[1], low[1]])
[fbD, ffD, ftD, fh3_D, fl3_D, fh1_D, fl1_D] = request.security(syminfo.tickerid, 'D', [low[1] > high[3] ? 1 : 0, high[1] < low[3] ? 1 : 0, time[3], high[3], low[3], high[1], low[1]])
[fbW, ffW, ftW, fh3_W, fl3_W, fh1_W, fl1_W] = request.security(syminfo.tickerid, 'W', [low[1] > high[3] ? 1 : 0, high[1] < low[3] ? 1 : 0, time[3], high[3], low[3], high[1], low[1]])
[fbM, ffM, ftM, fh3_M, fl3_M, fh1_M, fl1_M] = request.security(syminfo.tickerid, 'M', [low[1] > high[3] ? 1 : 0, high[1] < low[3] ? 1 : 0, time[3], high[3], low[3], high[1], low[1]])

// === Logic: Draw Native FVGs ===
if low[1] > high[3]
    drawFVG(time[3], low[1], high[3], nativeLabel, color.green, high[3], true, boxLength)
if high[1] < low[3]
    drawFVG(time[3], low[3], high[1], nativeLabel, color.red, low[3], false, boxLength)

// === Logic: Draw HTF FVGs ===
// 15m
if chartTFRank < rank15M
    var int lastTime15 = 0
    if ft15m != lastTime15
        if fb15m == 1
            drawFVG(ft15m, math.max(fl1_15, fh3_15), math.min(fl1_15, fh3_15), '15m', color.lime, fh3_15, true, boxLength)
        if ff15m == 1
            drawFVG(ft15m, math.max(fl3_15, fh1_15), math.min(fl3_15, fh1_15), '15m', color.maroon, fl3_15, false, boxLength)
        lastTime15 := ft15m

// 1H
if chartTFRank < rank1H
    var int lastTime1H = 0
    if ft1H != lastTime1H
        if fb1H == 1
            drawFVG(ft1H, math.max(fl1_1H, fh3_1H), math.min(fl1_1H, fh3_1H), '1H', color.lime, fh3_1H, true, boxLength)
        if ff1H == 1
            drawFVG(ft1H, math.max(fl3_1H, fh1_1H), math.min(fl3_1H, fh1_1H), '1H', color.maroon, fl3_1H, false, boxLength)
        lastTime1H := ft1H

// 4H
if chartTFRank < rank4H
    var int lastTime4H = 0
    if ft4H != lastTime4H
        if fb4H == 1
            drawFVG(ft4H, math.max(fl1_4H, fh3_4H), math.min(fl1_4H, fh3_4H), '4H', color.green, fh3_4H, true, boxLength4H)
        if ff4H == 1
            drawFVG(ft4H, math.max(fl3_4H, fh1_4H), math.min(fl3_4H, fh1_4H), '4H', color.red, fl3_4H, false, boxLength4H)
        lastTime4H := ft4H

// Daily
if chartTFRank < rankD
    var int lastTimeD = 0
    if ftD != lastTimeD
        if fbD == 1
            drawFVG(ftD, math.max(fl1_D, fh3_D), math.min(fl1_D, fh3_D), 'D', color.teal, fh3_D, true, boxLengthD)
        if ffD == 1
            drawFVG(ftD, math.max(fl3_D, fh1_D), math.min(fl3_D, fh1_D), 'D', color.orange, fl3_D, false, boxLengthD)
        lastTimeD := ftD

// Weekly
if chartTFRank < rankW
    var int lastTimeW = 0
    if ftW != lastTimeW
        if fbW == 1
            drawFVG(ftW, math.max(fl1_W, fh3_W), math.min(fl1_W, fh3_W), 'W', color.teal, fh3_W, true, boxLengthW)
        if ffW == 1
            drawFVG(ftW, math.max(fl3_W, fh1_W), math.min(fl3_W, fh1_W), 'W', color.orange, fl3_W, false, boxLengthW)
        lastTimeW := ftW

// Monthly
if chartTFRank < rankM
    var int lastTimeM = 0
    if ftM != lastTimeM
        if fbM == 1
            drawFVG(ftM, math.max(fl1_M, fh3_M), math.min(fl1_M, fh3_M), 'M', color.teal, fh3_M, true, boxLengthM)
        if ffM == 1
            drawFVG(ftM, math.max(fl3_M, fh1_M), math.min(fl3_M, fh1_M), 'M', color.orange, fl3_M, false, boxLengthM)
        lastTimeM := ftM

// === Disrespect & Cleanup & ALERTS ===
if array.size(fvgBoxes) > 0
    for i = array.size(fvgBoxes) - 1 to 0
        isBullish = array.get(fvgIsBullish, i)
        compare = array.get(fvgCompareLevels, i)
        createdBarIndex = array.get(fvgCreatedBars, i)
        b = array.get(fvgBoxes, i)
        hasAlerted = array.get(fvgAlerted, i)

        age = bar_index - createdBarIndex
        c = close

        // --- ALERT LOGIC ---
        bTop = box.get_top(b)
        bBot = box.get_bottom(b)

        // Check if price is INSIDE the box (wicks included)
        isInside = high >= bBot and low <= bTop

        if isInside and not hasAlerted
            alertMsg = 'Price entered ' + (isBullish ? 'Bullish' : 'Bearish') + ' FVG'
            alert(alertMsg, alert.freq_once_per_bar)
            array.set(fvgAlerted, i, true)

        // --- CLEANUP LOGIC ---
        disrespect = isBullish and c < compare or not isBullish and c > compare
        mitigated = isInside

        if age > maxTrackBars or disrespect or removeOnMitigation and mitigated
            box.delete(b)
            label.delete(array.get(fvgLabels, i))
            array.remove(fvgBoxes, i)
            array.remove(fvgLabels, i)
            array.remove(fvgCreatedBars, i)
            array.remove(fvgIsBullish, i)
            array.remove(fvgCompareLevels, i)
            array.remove(fvgAlerted, i)

// ============================
// Divergence for Many Indicators v4 (merged; logic/settings preserved)
// ============================
prd = input.int(defval=5, title='Pivot Period', minval=1, maxval=50)
source = input.string(defval='Close', title='Source for Pivot Points', options=['Close', 'High/Low'])
searchdiv = input.string(defval='Regular', title='Divergence Type', options=['Regular', 'Hidden', 'Regular/Hidden'])
showindis = input.string(defval='Full', title='Show Indicator Names', options=['Full', 'First Letter', "Don't Show"])
showlimit = input.int(1, title='Minimum Number of Divergence', minval=1, maxval=11)
maxpp = input.int(defval=10, title='Maximum Pivot Points to Check', minval=1, maxval=20)
maxbars = input.int(defval=100, title='Maximum Bars to Check', minval=30, maxval=200)
shownum = input.bool(defval=true, title='Show Divergence Number')
showlast = input.bool(defval=false, title='Show Only Last Divergence')
dontconfirm = input.bool(defval=false, title="Don't Wait for Confirmation")
showlines = input.bool(defval=true, title='Show Divergence Lines')
showpivot = input.bool(defval=false, title='Show Pivot Points')
calcmacd = input.bool(defval=true, title='MACD')
calcmacda = input.bool(defval=true, title='MACD Histogram')
calcrsi = input.bool(defval=true, title='RSI')
calcstoc = input.bool(defval=true, title='Stochastic')
calccci = input.bool(defval=true, title='CCI')
calcmom = input.bool(defval=true, title='Momentum')
calcobv = input.bool(defval=true, title='OBV')
calcvwmacd = input.bool(true, title='VWmacd')
calccmf = input.bool(true, title='Chaikin Money Flow')
calcmfi = input.bool(true, title='Money Flow Index')
calcext = input.bool(false, title='Check External Indicator')
externalindi = input.source(defval=close, title='External Indicator')
pos_reg_div_col = input.color(defval=color.yellow, title='Positive Regular Divergence')
neg_reg_div_col = input.color(defval=color.navy, title='Negative Regular Divergence')
pos_hid_div_col = input.color(defval=color.lime, title='Positive Hidden Divergence')
neg_hid_div_col = input.color(defval=color.red, title='Negative Hidden Divergence')
pos_div_text_col = input.color(defval=color.black, title='Positive Divergence Text Color')
neg_div_text_col = input.color(defval=color.white, title='Negative Divergence Text Color')
reg_div_l_style_ = input.string(defval='Solid', title='Regular Divergence Line Style', options=['Solid', 'Dashed', 'Dotted'])
hid_div_l_style_ = input.string(defval='Dashed', title='Hdden Divergence Line Style', options=['Solid', 'Dashed', 'Dotted'])
reg_div_l_width = input.int(defval=2, title='Regular Divergence Line Width', minval=1, maxval=5)
hid_div_l_width = input.int(defval=1, title='Hidden Divergence Line Width', minval=1, maxval=5)
showmas = input.bool(defval=false, title='Show MAs 50 & 200', inline='ma12')
cma1col = input.color(defval=color.lime, title='', inline='ma12')
cma2col = input.color(defval=color.red, title='', inline='ma12')
use_1h_pivot = input.bool(defval=true, title='Enable 1H Adjustable Pivot')
pivot_1h = input.int(defval=5, title='1H Pivot Period', minval=1, maxval=50)
use_4h_pivot = input.bool(defval=true, title='Enable 4H Adjustable Pivot')
pivot_4h = input.int(defval=5, title='4H Pivot Period', minval=1, maxval=50)
aligned_pos_bar_col = input.color(defval=color.lime, title='Aligned Bullish Bar Color')
aligned_neg_bar_col = input.color(defval=color.red, title='Aligned Bearish Bar Color')
aligned_lookback_bars = input.int(defval=500, title='Aligned Bar Color Lookback Bars', minval=1)

active_prd = timeframe.period == '60' and use_1h_pivot ? pivot_1h : timeframe.period == '240' and use_4h_pivot ? pivot_4h : prd
plot(showmas ? ta.sma(close, 50) : na, color=showmas ? cma1col : na)
plot(showmas ? ta.sma(close, 200) : na, color=showmas ? cma2col : na)
reg_div_l_style = reg_div_l_style_ == 'Solid' ? line.style_solid : reg_div_l_style_ == 'Dashed' ? line.style_dashed : line.style_dotted
hid_div_l_style = hid_div_l_style_ == 'Solid' ? line.style_solid : hid_div_l_style_ == 'Dashed' ? line.style_dashed : line.style_dotted
rsi = ta.rsi(close, 14)
[macd, signal, deltamacd] = ta.macd(close, 12, 26, 9)
moment = ta.mom(close, 10)
cci = ta.cci(close, 10)
Obv = ta.obv
stk = ta.sma(ta.stoch(close, high, low, 14), 3)
maFast = ta.vwma(close, 12)
maSlow = ta.vwma(close, 26)
vwmacd = maFast - maSlow
Cmfm = ((close - low) - (high - close)) / (high - low)
Cmfv = Cmfm * volume
cmf = ta.sma(Cmfv, 21) / ta.sma(volume, 21)
Mfi = ta.mfi(close, 14)
var indicators_name = array.new_string(11)
var div_colors = array.new_color(4)
if barstate.isfirst
    array.set(indicators_name, 0, showindis == 'Full' ? 'MACD' : 'M')
    array.set(indicators_name, 1, showindis == 'Full' ? 'Hist' : 'H')
    array.set(indicators_name, 2, showindis == 'Full' ? 'RSI' : 'E')
    array.set(indicators_name, 3, showindis == 'Full' ? 'Stoch' : 'S')
    array.set(indicators_name, 4, showindis == 'Full' ? 'CCI' : 'C')
    array.set(indicators_name, 5, showindis == 'Full' ? 'MOM' : 'M')
    array.set(indicators_name, 6, showindis == 'Full' ? 'OBV' : 'O')
    array.set(indicators_name, 7, showindis == 'Full' ? 'VWMACD' : 'V')
    array.set(indicators_name, 8, showindis == 'Full' ? 'CMF' : 'C')
    array.set(indicators_name, 9, showindis == 'Full' ? 'MFI' : 'M')
    array.set(indicators_name, 10, showindis == 'Full' ? 'Extrn' : 'X')
    array.set(div_colors, 0, pos_reg_div_col)
    array.set(div_colors, 1, neg_reg_div_col)
    array.set(div_colors, 2, pos_hid_div_col)
    array.set(div_colors, 3, neg_hid_div_col)

float ph = ta.pivothigh(source == 'Close' ? close : high, active_prd, active_prd)
float pl = ta.pivotlow(source == 'Close' ? close : low, active_prd, active_prd)
plotshape(showpivot and not na(ph), text='H', style=shape.labeldown, color=color.new(color.white, 100), textcolor=color.red, location=location.abovebar, offset=-active_prd)
plotshape(showpivot and not na(pl), text='L', style=shape.labelup, color=color.new(color.white, 100), textcolor=color.lime, location=location.belowbar, offset=-active_prd)

var int maxarraysize = 20
var ph_positions = array.new_int(maxarraysize, 0)
var pl_positions = array.new_int(maxarraysize, 0)
var ph_vals = array.new_float(maxarraysize, 0.0)
var pl_vals = array.new_float(maxarraysize, 0.0)
if not na(ph)
    array.unshift(ph_positions, bar_index)
    array.unshift(ph_vals, ph)
    if array.size(ph_positions) > maxarraysize
        array.pop(ph_positions)
        array.pop(ph_vals)
if not na(pl)
    array.unshift(pl_positions, bar_index)
    array.unshift(pl_vals, pl)
    if array.size(pl_positions) > maxarraysize
        array.pop(pl_positions)
        array.pop(pl_vals)

positive_regular_positive_hidden_divergence(src, cond) =>
    divlen = 0
    prsc = source == 'Close' ? close : low
    if dontconfirm or src > src[1] or close > close[1]
        startpoint = dontconfirm ? 0 : 1
        for x = 0 to maxpp - 1
            len = bar_index - array.get(pl_positions, x) + active_prd
            if array.get(pl_positions, x) == 0 or len > maxbars
                break
            if len > 5 and ((cond == 1 and src[startpoint] > src[len] and prsc[startpoint] < nz(array.get(pl_vals, x))) or (cond == 2 and src[startpoint] < src[len] and prsc[startpoint] > nz(array.get(pl_vals, x))))
                slope1 = (src[startpoint] - src[len]) / (len - startpoint)
                virtual_line1 = src[startpoint] - slope1
                slope2 = (close[startpoint] - close[len]) / (len - startpoint)
                virtual_line2 = close[startpoint] - slope2
                arrived = true
                for y = 1 + startpoint to len - 1
                    if src[y] < virtual_line1 or nz(close[y]) < virtual_line2
                        arrived := false
                        break
                    virtual_line1 := virtual_line1 - slope1
                    virtual_line2 := virtual_line2 - slope2
                if arrived
                    divlen := len
                    break
    divlen
negative_regular_negative_hidden_divergence(src, cond) =>
    divlen = 0
    prsc = source == 'Close' ? close : high
    if dontconfirm or src < src[1] or close < close[1]
        startpoint = dontconfirm ? 0 : 1
        for x = 0 to maxpp - 1
            len = bar_index - array.get(ph_positions, x) + active_prd
            if array.get(ph_positions, x) == 0 or len > maxbars
                break
            if len > 5 and ((cond == 1 and src[startpoint] < src[len] and prsc[startpoint] > nz(array.get(ph_vals, x))) or (cond == 2 and src[startpoint] > src[len] and prsc[startpoint] < nz(array.get(ph_vals, x))))
                slope1 = (src[startpoint] - src[len]) / (len - startpoint)
                virtual_line1 = src[startpoint] - slope1
                slope2 = (close[startpoint] - nz(close[len])) / (len - startpoint)
                virtual_line2 = close[startpoint] - slope2
                arrived = true
                for y = 1 + startpoint to len - 1
                    if src[y] > virtual_line1 or nz(close[y]) > virtual_line2
                        arrived := false
                        break
                    virtual_line1 := virtual_line1 - slope1
                    virtual_line2 := virtual_line2 - slope2
                if arrived
                    divlen := len
                    break
    divlen
calculate_divs(cond, indicator) =>
    divs = array.new_int(4, 0)
    array.set(divs, 0, cond and (searchdiv == 'Regular' or searchdiv == 'Regular/Hidden') ? positive_regular_positive_hidden_divergence(indicator, 1) : 0)
    array.set(divs, 1, cond and (searchdiv == 'Regular' or searchdiv == 'Regular/Hidden') ? negative_regular_negative_hidden_divergence(indicator, 1) : 0)
    array.set(divs, 2, cond and (searchdiv == 'Hidden' or searchdiv == 'Regular/Hidden') ? positive_regular_positive_hidden_divergence(indicator, 2) : 0)
    array.set(divs, 3, cond and (searchdiv == 'Hidden' or searchdiv == 'Regular/Hidden') ? negative_regular_negative_hidden_divergence(indicator, 2) : 0)
    divs
var all_divergences = array.new_int(44)
array_set_divs(div_pointer, index) =>
    for x = 0 to 3
        array.set(all_divergences, index * 4 + x, array.get(div_pointer, x))
array_set_divs(calculate_divs(calcmacd, macd), 0)
array_set_divs(calculate_divs(calcmacda, deltamacd), 1)
array_set_divs(calculate_divs(calcrsi, rsi), 2)
array_set_divs(calculate_divs(calcstoc, stk), 3)
array_set_divs(calculate_divs(calccci, cci), 4)
array_set_divs(calculate_divs(calcmom, moment), 5)
array_set_divs(calculate_divs(calcobv, Obv), 6)
array_set_divs(calculate_divs(calcvwmacd, vwmacd), 7)
array_set_divs(calculate_divs(calccmf, cmf), 8)
array_set_divs(calculate_divs(calcmfi, Mfi), 9)
array_set_divs(calculate_divs(calcext, externalindi), 10)
total_div = 0
for x = 0 to array.size(all_divergences) - 1
    total_div += math.round(math.sign(array.get(all_divergences, x)))
if total_div < showlimit
    array.fill(all_divergences, 0)

var pos_div_lines = array.new_line(0)
var neg_div_lines = array.new_line(0)
var pos_div_labels = array.new_label(0)
var neg_div_labels = array.new_label(0)

delete_old_pos_div_lines() =>
    if array.size(pos_div_lines) > 0
        for j = 0 to array.size(pos_div_lines) - 1
            line.delete(array.get(pos_div_lines, j))
        array.clear(pos_div_lines)

delete_old_neg_div_lines() =>
    if array.size(neg_div_lines) > 0
        for j = 0 to array.size(neg_div_lines) - 1
            line.delete(array.get(neg_div_lines, j))
        array.clear(neg_div_lines)

delete_old_pos_div_labels() =>
    if array.size(pos_div_labels) > 0
        for j = 0 to array.size(pos_div_labels) - 1
            label.delete(array.get(pos_div_labels, j))
        array.clear(pos_div_labels)

delete_old_neg_div_labels() =>
    if array.size(neg_div_labels) > 0
        for j = 0 to array.size(neg_div_labels) - 1
            label.delete(array.get(neg_div_labels, j))
        array.clear(neg_div_labels)

delete_last_pos_div_lines_label(n) =>
    if n > 0 and array.size(pos_div_lines) >= n
        asz = array.size(pos_div_lines)
        for j = 1 to n
            line.delete(array.get(pos_div_lines, asz - j))
            array.pop(pos_div_lines)
        if array.size(pos_div_labels) > 0
            label.delete(array.get(pos_div_labels, array.size(pos_div_labels) - 1))
            array.pop(pos_div_labels)

delete_last_neg_div_lines_label(n) =>
    if n > 0 and array.size(neg_div_lines) >= n
        asz = array.size(neg_div_lines)
        for j = 1 to n
            line.delete(array.get(neg_div_lines, asz - j))
            array.pop(neg_div_lines)
        if array.size(neg_div_labels) > 0
            label.delete(array.get(neg_div_labels, array.size(neg_div_labels) - 1))
            array.pop(neg_div_labels)

pos_reg_div_detected = false
neg_reg_div_detected = false
pos_hid_div_detected = false
neg_hid_div_detected = false

var last_pos_div_lines = 0
var last_neg_div_lines = 0
var remove_last_pos_divs = false
var remove_last_neg_divs = false
if not na(pl)
    remove_last_pos_divs := false
    last_pos_div_lines := 0
if not na(ph)
    remove_last_neg_divs := false
    last_neg_div_lines := 0

divergence_text_top = ''
divergence_text_bottom = ''
distances = array.new_int(0)
dnumdiv_top = 0
dnumdiv_bottom = 0
top_label_col = color.white
bottom_label_col = color.white
old_pos_divs_can_be_removed = true
old_neg_divs_can_be_removed = true
startpoint = dontconfirm ? 0 : 1

for x = 0 to 10
    div_type = -1
    for y = 0 to 3
        if array.get(all_divergences, x * 4 + y) > 0
            div_type := y
            if y % 2 == 1
                dnumdiv_top += 1
                top_label_col := array.get(div_colors, y)
            if y % 2 == 0
                dnumdiv_bottom += 1
                bottom_label_col := array.get(div_colors, y)
            if not array.includes(distances, array.get(all_divergences, x * 4 + y))
                array.push(distances, array.get(all_divergences, x * 4 + y))
                new_line = showlines ? line.new(x1=bar_index - array.get(all_divergences, x * 4 + y), y1=source == 'Close' ? close[array.get(all_divergences, x * 4 + y)] : y % 2 == 0 ? low[array.get(all_divergences, x * 4 + y)] : high[array.get(all_divergences, x * 4 + y)], x2=bar_index - startpoint, y2=source == 'Close' ? close[startpoint] : y % 2 == 0 ? low[startpoint] : high[startpoint], color=array.get(div_colors, y), style=y < 2 ? reg_div_l_style : hid_div_l_style, width=y < 2 ? reg_div_l_width : hid_div_l_width) : na
                if y % 2 == 0
                    if old_pos_divs_can_be_removed
                        old_pos_divs_can_be_removed := false
                        if not showlast and remove_last_pos_divs
                            delete_last_pos_div_lines_label(last_pos_div_lines)
                            last_pos_div_lines := 0
                        if showlast
                            delete_old_pos_div_lines()
                    array.push(pos_div_lines, new_line)
                    last_pos_div_lines += 1
                    remove_last_pos_divs := true
                if y % 2 == 1
                    if old_neg_divs_can_be_removed
                        old_neg_divs_can_be_removed := false
                        if not showlast and remove_last_neg_divs
                            delete_last_neg_div_lines_label(last_neg_div_lines)
                            last_neg_div_lines := 0
                        if showlast
                            delete_old_neg_div_lines()
                    array.push(neg_div_lines, new_line)
                    last_neg_div_lines += 1
                    remove_last_neg_divs := true
            if y == 0
                pos_reg_div_detected := true
            if y == 1
                neg_reg_div_detected := true
            if y == 2
                pos_hid_div_detected := true
            if y == 3
                neg_hid_div_detected := true

    if div_type >= 0
        divergence_text_top += div_type % 2 == 1 ? showindis != "Don't Show" ? array.get(indicators_name, x) + '\n' : '' : ''
        divergence_text_bottom += div_type % 2 == 0 ? showindis != "Don't Show" ? array.get(indicators_name, x) + '\n' : '' : ''

if showindis != "Don't Show" or shownum
    if shownum and dnumdiv_top > 0
        divergence_text_top += str.tostring(dnumdiv_top)
    if shownum and dnumdiv_bottom > 0
        divergence_text_bottom += str.tostring(dnumdiv_bottom)

    if divergence_text_top != ''
        if showlast
            delete_old_neg_div_labels()
        array.push(neg_div_labels, label.new(x=bar_index, y=math.max(high, high[1]), text=divergence_text_top, color=top_label_col, textcolor=neg_div_text_col, style=label.style_label_down))

    if divergence_text_bottom != ''
        if showlast
            delete_old_pos_div_labels()
        array.push(pos_div_labels, label.new(x=bar_index, y=math.min(low, low[1]), text=divergence_text_bottom, color=bottom_label_col, textcolor=pos_div_text_col, style=label.style_label_up))

alertcondition(pos_reg_div_detected, title='Positive Regular Divergence Detected', message='Positive Regular Divergence Detected')
alertcondition(neg_reg_div_detected, title='Negative Regular Divergence Detected', message='Negative Regular Divergence Detected')
alertcondition(pos_hid_div_detected, title='Positive Hidden Divergence Detected', message='Positive Hidden Divergence Detected')
alertcondition(neg_hid_div_detected, title='Negative Hidden Divergence Detected', message='Negative Hidden Divergence Detected')
alertcondition(pos_reg_div_detected or pos_hid_div_detected, title='Positive Divergence Detected', message='Positive Divergence Detected')
alertcondition(neg_reg_div_detected or neg_hid_div_detected, title='Negative Divergence Detected', message='Negative Divergence Detected')

current_pos_div = false
current_neg_div = false
for i = 0 to 21
    current_pos_div := current_pos_div or array.get(all_divergences, i * 2) > 0
    current_neg_div := current_neg_div or array.get(all_divergences, i * 2 + 1) > 0
current_div_state = current_pos_div ? 1 : current_neg_div ? -1 : 0
daily_div_state = request.security(syminfo.tickerid, 'D', current_div_state)
weekly_div_state = request.security(syminfo.tickerid, 'W', current_div_state)
monthly_div_state = request.security(syminfo.tickerid, 'M', current_div_state)
is_target_tf = timeframe.period == '60' or timeframe.period == '240'
aligned_pos_signal = is_target_tf and current_div_state == 1 and daily_div_state == 1 and weekly_div_state == 1 and monthly_div_state == 1
aligned_neg_signal = is_target_tf and current_div_state == -1 and daily_div_state == -1 and weekly_div_state == -1 and monthly_div_state == -1
var int aligned_pos_bars_left = 0
var int aligned_neg_bars_left = 0
if aligned_pos_signal and not aligned_pos_signal[1]
    aligned_pos_bars_left := 2
else if aligned_pos_bars_left > 0
    aligned_pos_bars_left := aligned_pos_bars_left - 1
if aligned_neg_signal and not aligned_neg_signal[1]
    aligned_neg_bars_left := 2
else if aligned_neg_bars_left > 0
    aligned_neg_bars_left := aligned_neg_bars_left - 1
show_aligned_history = true
barcolor(is_target_tf and show_aligned_history ? aligned_pos_bars_left > 0 ? aligned_pos_bar_col : aligned_neg_bars_left > 0 ? aligned_neg_bar_col : na : na)
alertcondition(daily_div_state == 1, title='Daily Positive Divergence Detected', message='Daily Positive Divergence Detected')
alertcondition(daily_div_state == -1, title='Daily Negative Divergence Detected', message='Daily Negative Divergence Detected')
alertcondition(weekly_div_state == 1, title='Weekly Positive Divergence Detected', message='Weekly Positive Divergence Detected')
alertcondition(weekly_div_state == -1, title='Weekly Negative Divergence Detected', message='Weekly Negative Divergence Detected')
alertcondition(monthly_div_state == 1, title='Monthly Positive Divergence Detected', message='Monthly Positive Divergence Detected')
alertcondition(monthly_div_state == -1, title='Monthly Negative Divergence Detected', message='Monthly Negative Divergence Detected')

